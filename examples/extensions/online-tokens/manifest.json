{
  "manifestVersion": 1,
  "id": "open20.online-tokens",
  "name": { "es": "Tokens en línea", "en": "Online tokens" },
  "version": "1.0.0",
  "description": {
    "es": "Busca tokens en un servicio en línea, los guarda en un pack editable y sincroniza la mesa.",
    "en": "Searches tokens in an online service, saves them in an editable pack and syncs the table."
  },
  "author": { "name": "Open20", "url": "https://open20.app" },
  "license": "MIT",
  "engines": { "battlemaps": "^1.0.0" },
  "main": "main.js",
  "permissions": [
    "map:read",
    "library:read",
    "packs:write",
    "ui",
    "services",
    "network:api.open20.app",
    "openUrl",
    "fonts",
    "preferences:read"
  ],
  "optionalPermissions": ["network:live.open20.app"],
  "dependencies": { "open20.hex-grid": "^1.0.0" },
  "contributes": {
    "locales": { "es": "locales/es.json", "en": "locales/en.json" },
    "settings": {
      "server": {
        "type": "select",
        "label": { "es": "Servidor", "en": "Server" },
        "default": "main",
        "options": [{ "value": "main", "label": "api.open20.app" }]
      },
      "limit": {
        "type": "number",
        "label": { "es": "Resultados", "en": "Results" },
        "default": 40,
        "min": 10,
        "max": 200
      }
    }
  }
}
