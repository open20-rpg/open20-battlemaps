{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open20 Battle Maps",
  "version": "1.0.0",
  "identifier": "app.open20.battlemaps",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Open20 Battle Maps",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 400,
        "backgroundColor": "#1a1a1a"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/packs/**", "$APPDATA/fonts/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/builtin.dungeondraft_pack": "builtin.dungeondraft_pack"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
